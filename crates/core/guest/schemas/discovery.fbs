// Flatbuffers schema for discovery service messages.
namespace selium.discovery;

/// Interface metadata for a discovered resource.
table InterfaceMetadata {
    /// Interface name.
    name: string;
    /// Method names exposed by the interface.
    methods: [string];
}

/// Target resource returned by discovery resolution.
table ResourceTarget {
    /// URI of the resource.
    uri: string;
    /// Host id where the resource resides.
    host_id: string;
    /// Resource identifier.
    resource_id: ulong;
    /// Optional interface metadata.
    interface: InterfaceMetadata;
    /// Optional tenant identifier for multi-tenant isolation.
    tenant: string;
}

/// Discovery request message.
///
/// Variant tag values:
///   0 = Resolve(uri)
///   1 = Register { uri, target }
///   2 = Revoke { uri }
table DiscoveryRequest {
    /// Variant discriminator.
    variant: ubyte;
    /// URI to resolve or register (used by Resolve, Register, Revoke variants).
    uri: string;
    /// Target resource for registration (used by Register variant).
    target: ResourceTarget;
}

/// Discovery response message.
///
/// Variant tag values:
///   0 = Found(target)
///   1 = NotFound
///   2 = Registered
///   3 = Revoked
///   4 = Forbidden
table DiscoveryResponse {
    /// Variant discriminator.
    variant: ubyte;
    /// The discovered resource (used by Found variant).
    target: ResourceTarget;
}

root_type DiscoveryResponse;
